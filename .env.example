DATABASE_URL=postgres://estrada:estrada@localhost:5432/estrada
# At least 16 characters; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
APP_URL=https://erp.erpestrada.com
# Leave empty in development: emails are printed to the server console
RESEND_API_KEY=
EMAIL_FROM="ERP Estrada <no-reply@estrada.local>"
# Who locks the final RKA version: director | finance
RKA_LOCK_ROLE=finance
# Daily reminders: a scheduler calls GET /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
REMINDER_PENDING_DAYS=3

# Payment attachments (Permintaan Pembayaran). Production: a private Supabase Storage bucket.
# Leave empty in development: files are written to apps/web/.uploads (gitignored).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=payment-documents
