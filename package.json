{
  "name": "estrada-erp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm --filter web lint",
    "db:generate": "pnpm --filter @estrada/db generate",
    "db:migrate": "pnpm --filter @estrada/db migrate",
    "db:seed": "pnpm --filter @estrada/db seed && pnpm db:master && pnpm --filter @estrada/db seed:demo",
    "e2e": "pnpm --filter web e2e",
    "db:import": "pnpm --filter @estrada/importers load",
    "db:master": "pnpm --filter @estrada/importers master",
    "db:struktur": "pnpm --filter @estrada/importers struktur"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
